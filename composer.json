{
    "name": "polis/polis-laravel",
    "description": "Polis Laravel Package",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Polis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polis\\Tests\\": "tests/"
        },
        "comment": "The dummy consumer app (App\\, Database\\Factories\\, Database\\Seeders\\ -> tests/Application) is deliberately NOT mapped here. Registering it globally would leak the consumer app into the standalone Unit suite, which must test the Polis package in isolation. Those namespaces are registered dynamically for the Feature/Integration suites only, in tests/bootstrap-app.php."
    },
    "require": {
        "php": ">=8.3.0",
        "adminui/laravel-eloquent-joins": "^13.0",
        "cartalyst/stripe-laravel": "^15.0 || ^16.0 || ^17.0",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/cache": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/events": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/mail": "^11.0 || ^12.0",
        "illuminate/notifications": "^11.0 || ^12.0",
        "illuminate/queue": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/validation": "^11.0 || ^12.0",
        "jolicode/slack-php-api": "^4.0",
        "kreait/laravel-firebase": "^7.0",
        "laravel-notification-channels/fcm": "^5.1 || ^6.0",
        "laravel-notification-channels/twilio": "^4.0",
        "php-open-source-saver/jwt-auth": "^2.0",
        "sebastian/diff": "^5.0 || ^6.0 || ^7.0 || ^9.0",
        "xantios/mimey": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "dg/bypass-finals": "^1.6",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^13.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "test-coverage-html": "phpunit --coverage-html coverage",
        "test:coverage": "phpunit --testsuite=Unit --coverage-clover=coverage.xml --coverage-html=coverage-html",
        "test:coverage:text": "phpunit --testsuite=Unit --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
