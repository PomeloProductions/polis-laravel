parameters:
    level: 1
    paths:
        - src
    excludePaths:
        # These files extend or reference consumer-app (App\*) classes that
        # don't exist inside the package. Consuming apps will provide them.
        - src/Models/User/ProfileImage.php
        - src/Models/User/User.php
    ignoreErrors:
        # Optional dependencies not installed in the package
        - identifier: class.notFound
        - identifier: attribute.notFound
        # Eloquent magic static methods (where, etc.)
        - identifier: staticMethod.notFound
        # StripePaymentService constructor mismatch (app-level override expected)
        -
            message: '#constructor invoked with 6 parameters#'
            path: src/Providers/BaseServiceProvider.php
    reportUnmatchedIgnoredErrors: false
